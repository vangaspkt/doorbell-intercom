<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Vùng hiển thị camera -->
    <ImageView
        android:id="@+id/imgCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/black" />

    <!-- Thanh tiêu đề mờ trên cùng -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#88000000"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CÓ NGƯỜI ĐANG BẤM CHUÔNG"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang nhận luồng hình ảnh..."
            android:textColor="#FFEB3B"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Nút điều khiển nhanh phụ (Đèn, Còi) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/topBar"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <Button
            android:id="@+id/btnLight"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Bật Đèn"
            android:textSize="12sp"
            android:backgroundTint="#FF9800"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBuzzer"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Bấm Còi"
            android:textSize="12sp"
            android:backgroundTint="#9C27B0"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Khu vực phím điều khiển dưới cùng -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:padding="20dp"
        android:background="#99000000">

        <!-- Nút Cúp máy / Đóng màn hình -->
        <Button
            android:id="@+id/btnHangup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:text="Cúp Máy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/red_hangup"
            android:textColor="@color/white"
            android:layout_marginEnd="12dp" />

        <!-- Nút Giữ để nói (Push to Talk) -->
        <Button
            android:id="@+id/btnTalk"
            android:layout_width="0dp"
            android:layout_weight="1.6"
            android:layout_height="64dp"
            android:text="Giữ Để Nói 🎙️"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/green_call"
            android:textColor="@color/white" />

    </LinearLayout>

</RelativeLayout>

